<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── SECCIÓN CHAT CON RELOJ ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chat con reloj"
            android:textStyle="bold"
            android:textColor="#880E4F"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mensaje para el reloj..."
            android:inputType="text"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#F48FB1"
            android:textColor="#880E4F"
            android:textColorHint="#F06292" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mensajes del reloj aparecerán aquí"
            android:textSize="14sp"
            android:textColor="#AD1457"
            android:padding="12dp"
            android:background="#F8BBD0"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/boton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Conectar"
                android:backgroundTint="#880E4F"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Enviar"
                android:backgroundTint="#E91E63"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- ── SECCIÓN HTTP ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peticiones HTTP"
            android:textStyle="bold"
            android:textColor="#880E4F"
            android:layout_marginBottom="8dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnGet"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="GET"
                android:backgroundTint="#AD1457"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="POST"
                android:backgroundTint="#E91E63"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/textRespuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Respuesta HTTP aparecerá aquí"
            android:textSize="12sp"
            android:textColor="#AD1457"
            android:padding="12dp"
            android:background="#F8BBD0" />

    </LinearLayout>
</ScrollView>
