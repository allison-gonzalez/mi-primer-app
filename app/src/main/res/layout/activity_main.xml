<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitor de Salud"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#880E4F"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <!-- Estado de conexión -->
        <TextView
            android:id="@+id/tvEstadoCelular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Esperando datos del reloj..."
            android:textSize="12sp"
            android:textColor="#AD1457"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Datos actuales del reloj -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Datos en tiempo real"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#880E4F"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8BBD0"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvRitmoCelular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❤  --  bpm"
                android:textSize="20sp"
                android:textColor="#C2185B"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvPasosCelular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👟  --  pasos"
                android:textSize="18sp"
                android:textColor="#1565C0"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvGiroCelular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄  --  rad/s"
                android:textSize="16sp"
                android:textColor="#2E7D32"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Botón para ver resumen del día desde la BD -->
        <Button
            android:id="@+id/btnGet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver resumen del día"
            android:backgroundTint="#880E4F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- Respuesta del servidor -->
        <TextView
            android:id="@+id/textRespuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="El resumen del día aparecerá aquí"
            android:textSize="12sp"
            android:textColor="#AD1457"
            android:padding="12dp"
            android:background="#F8BBD0"/>

    </LinearLayout>
</ScrollView>
